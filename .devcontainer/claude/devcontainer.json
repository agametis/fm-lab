// fm-lab + Claude Code — VS Code Dev Container variant (Scenario 2).
//
// A second, selectable devcontainer config (VS Code lets you pick it under
// "Dev Containers: Reopen in Container"). It layers the Claude Code overlay on top of
// the base compose, so you get the full fm-lab tool PLUS the Claude Code CLI, a
// persistent login, the bundled duckdb-skills, and the opt-in egress firewall.
//
// Auth — the ONLY manual step: provide credentials. Either set ANTHROPIC_API_KEY in
// the environment (or a `.env` next to the compose files) before opening, or run
// `claude auth login` once inside the container (the token persists in the fmlab-claude
// volume across rebuilds). No secret is ever baked into the image.
//
// This file targets the PUBLISHED layout: it lives at .devcontainer/claude/ and the
// compose files sit at the repo root (../../).
{
  "name": "fm-lab + Claude Code",

  // Base compose + the Claude overlay (claude image, login volume, firewall caps).
  "dockerComposeFile": [
    "../../docker-compose.yml",
    "../../docker-compose.claude.yml"
  ],
  "service": "api",
  "overrideCommand": true,
  "workspaceFolder": "/workspaces/fm-lab",

  // Everything runs in the ONE attached container (api). Limiting runServices to `api`
  // keeps the separate `web` service (pure-docker path) from also starting; `setup` is
  // still pulled in via api's depends_on.
  "runServices": ["api"],

  "remoteUser": "node",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "anthropic.claude-code"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": { "path": "bash", "icon": "terminal-bash" },
          "zsh": { "path": "zsh" }
        }
      }
    }
  },

  // Bootstrap: ensure node_modules (idempotent — the compose `setup` service normally
  // did this), then seed the project .claude/settings.json from the baked template
  // (permissions + the duckdb-skills marketplace) when the repo doesn't have one yet.
  "postCreateCommand": "test -d node_modules/.bin || (sudo /usr/local/bin/init-node-modules.sh /workspaces/fm-lab && npm install && npm run build:shared); test -f .claude/settings.json || cp /opt/fmlab/claude-settings.seed.json .claude/settings.json",

  // On each start: apply the opt-in egress firewall (the overlay grants NET_ADMIN/
  // NET_RAW; the script no-ops gracefully if the caps are ever removed), log the Claude
  // Code auth state + next step, then auto-start the stack (REST API 3003 + Vite 5173)
  // so the container is immediately usable — Claude itself is reached via the VS Code
  // plugin, no terminal step. start-servers.sh is idempotent across restarts.
  //
  // `setsid` on the start-servers.sh call is the process HANDOVER across the init phase:
  // it runs the script in its OWN session/group, decoupled from the docker-exec session of
  // this postStartCommand. Without it the backgrounded servers stay in the exec's process
  // group and are killed when the lifecycle command's session is torn down (dead ports →
  // white page). The firewall + auth-preflight steps stay in the foreground (they must
  // complete first); only the long-running server launch is handed off.
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh; /usr/local/bin/claude-auth-preflight.sh || true; setsid bash tools/start-servers.sh",

  // 5173 uses "notify" (clickable toast), NOT "openBrowser": openBrowser reopens the
  // browser on the HOST every time the forward is (re-)established — if Vite dies while
  // a frontend tab is open, the flapping forward spawns endless new tabs and steals
  // focus. See the note in ../devcontainer.json.
  "forwardPorts": [3003, 5173],
  "portsAttributes": {
    "3003": { "label": "REST-API", "onAutoForward": "silent" },
    "5173": { "label": "Web-Frontend", "onAutoForward": "notify" }
  }
}
