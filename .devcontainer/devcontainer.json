// fm-lab — public VS Code Dev Container (clean, host-path-free).
//
// A THIN wrapper over docker-compose.yml: the compose file is the single source of
// truth (same image, volumes, ports, bootstrap), so "pure docker" (docker compose up)
// and "VS Code Dev Container" stay guaranteed-consistent.
//
// Bootstrap (npm install + build:shared + ownership of the node_modules/spill volumes
// + an empty placeholder catalog DB) is performed by the compose `setup` service,
// which the `api` service depends on — so it runs to completion before this container
// is ready. The `postCreateCommand` below is only an idempotent safety net.
//
// This file targets the PUBLISHED layout, where it lives at .devcontainer/
// devcontainer.json and the compose file sits at the repo root (../docker-compose.yml).
{
  "name": "fm-lab",

  // Single source of truth — reuse the repo-root compose definition.
  "dockerComposeFile": ["../docker-compose.yml"],

  // Attach to the API service (it carries the full toolchain: DuckDB CLI, webbed,
  // Node/npm, the conversion harness). Its command is overridden so the container stays
  // alive for development; the servers are then auto-started by postStartCommand below.
  "service": "api",
  "overrideCommand": true,
  "workspaceFolder": "/workspaces/fm-lab",

  // Dev-container model: everything runs in the ONE attached container (api). Limiting
  // runServices to `api` keeps the separate `web` service (pure-docker path) from also
  // starting — otherwise a second Vite + a proxy to the idled api:3003 would surface a
  // broken UI. `setup` is still pulled in automatically via api's depends_on.
  "runServices": ["api"],

  "remoteUser": "node",

  "customizations": {
    "vscode": {
      // Neutral, tool-agnostic extension set — formatting/linting only. Agent
      // extensions (e.g. Claude Code) belong to the agent image variants, not the
      // base tool.
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "bash": { "path": "bash", "icon": "terminal-bash" },
          "zsh": { "path": "zsh" }
        }
      }
    }
  },

  // Idempotent safety net: if the compose `setup` service already populated the
  // node_modules volumes this is a no-op; otherwise it bootstraps here.
  "postCreateCommand": "test -d node_modules/.bin || (sudo /usr/local/bin/init-node-modules.sh /workspaces/fm-lab && npm install && npm run build:shared)",

  // Auto-start the stack on every container start — no terminal, no manual step. This
  // launches the REST API (3003) and the Vite web client (5173) in this container;
  // start-servers.sh is idempotent, so a restart re-attaches instead of double-starting.
  //
  // `setsid` is the process HANDOVER across the init phase: postStartCommand runs in a
  // docker-exec session, and start-servers.sh backgrounds the servers into THAT session's
  // process group (a non-interactive shell has no job control, so `&` does not fork off a
  // new group). When the lifecycle command finishes and the exec session is torn down, the
  // group is signalled — killing the just-started servers (dead ports → white page). setsid
  // runs the script in its OWN new session/group, decoupled from the exec teardown, so the
  // servers survive. Only this dev-container autostart path needs it; native/manual runs
  // (persistent terminal) and the pure-docker path (foreground PID-1 servers) are unaffected,
  // so the shared start-servers.sh stays generic.
  "postStartCommand": "setsid bash tools/start-servers.sh",

  // Forward both servers to the host. 5173 uses "notify" (clickable toast), NOT
  // "openBrowser": openBrowser runs `open http://localhost:5173` on the HOST every time
  // the forward is (re-)established. If the Vite dev server dies while a frontend tab is
  // open (full stop, crash, restart), the forward flaps and the browser gets a stream of
  // new tabs plus focus stealing — closing the windows doesn't help, the opener is VS
  // Code. The HMR client's reload polling amplifies this (any HTTP answer on the
  // forwarded port counts as "server is back").
  "forwardPorts": [3003, 5173],
  "portsAttributes": {
    "3003": { "label": "REST-API", "onAutoForward": "silent" },
    "5173": { "label": "Web-Frontend", "onAutoForward": "notify" }
  }
}
