# fm-lab — optional environment overrides for `docker compose up`.
#
# Copy to `.env` (same directory as docker-compose.yml) and uncomment what you need.
# Every value below has a sane default baked into the compose files, so an empty or
# absent .env works out of the box. Docker Compose reads this file automatically.

# ── Base stack tuning ────────────────────────────────────────────────────────────
# DuckDB CLI / webbed extension version baked into the image.
#FMLAB_DUCKDB_VERSION=1.5.4

# DuckDB thread cap for the conversion (raise on big hosts, lower on tight ones).
#FMLAB_DUCKDB_THREADS=4

# Per-container RAM cap for the api + ingestion services. On Docker Desktop, make sure
# the Docker VM itself has at least this much (Settings → Resources); ≥ 8g is
# recommended for large solutions.
#FMLAB_MEM_LIMIT=8g

# Host repo root shown by the web client's "open folder" empty-state affordance.
# ${PWD} is filled in from the host shell at `docker compose up` time. Under
# PowerShell/CMD, PWD is not an env var — set this explicitly if the empty-state card
# shows the in-container path instead of your host path.
#FMLAB_HOST_REPO_ROOT=

# ── Claude Code agent overlay (docker-compose.claude.yml) ────────────────────────
# Only needed for the agent stack, and only if you prefer key/token auth over the
# interactive `docker compose exec -it api claude` browser sign-in (which persists in
# the fmlab-claude volume). Provide ONE of the two — never both.
#
# API-key billing:
#ANTHROPIC_API_KEY=

# Subscription token from `claude setup-token`:
#CLAUDE_CODE_OAUTH_TOKEN=
