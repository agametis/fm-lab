# macOS-specific files
.DS_Store

# Environment variable files
.env
.env.local

# IDE-specific files
.vscode/
.idea/

# Log files
*.log
logs/*
!logs/.gitkeep

# Database files
*.duckdb
*.duckdb.wal
db/*
!db/.gitkeep
# Reference DB is shipped with the repo (FileMaker function and script step reference)
# — the *.duckdb glob above would otherwise drop it, so allow it back in explicitly.
# SOURCES.md (attribution, sibling of the DB)
!reference/fm_spec.duckdb
!reference/fm_spec.meta.json
!reference/SOURCES.md

# Data directory
data/*
!data/.gitkeep

# XML files
xml/*
!xml/.gitkeep

# Docs directory (loaded on demand via install skills)
docs/*
!docs/.gitkeep
!docs/agents/
!docs/agents/**
!docs/fm-lab/
!docs/fm-lab/**

# Node.js dependencies
node_modules/
# package-lock.json is COMMITTED on purpose (do not ignore it): the lockfile records
# every native optionalDependency for all OS/CPU combos (@duckdb/node-bindings-*,
# @esbuild/*, @rollup/rollup-*), so a fresh `npm install` installs the correct
# per-platform binding deterministically. Without it, npm intermittently skips the
# current platform's binding (macOS/npm 10.5.2 → MODULE_NOT_FOUND, native start crashes).

# Workspaces - build artifacts
rest-api/logs
rest-api/.env
packages/shared/dist/
packages/shared/generated/*.js
packages/shared/generated/*.d.ts
packages/shared/generated/*.map
apps/*/node_modules
apps/*/dist
apps/*/build
apps/*/.env.local
apps/*/.env.production

# Local Claude settings
.claude/settings.json
.claude/settings.local.json
.claude/worktrees/

# Plugin settings (local, generated on first run)
.fmlab/plugins.json
.fmlab/plugins/
