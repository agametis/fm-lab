# REST-API base URL for the browser. Leave EMPTY for same-origin proxy mode:
# the app then calls the API via the relative path `/api`, and the Vite dev server
# proxies those requests server-side to the API (vite.config.ts). This is host-,
# container- and port-forwarding-independent — the browser never needs to reach
# 3003 directly. Only set an absolute URL to point the browser at a specific API
# host (e.g. a remote API on another machine).
#
# NOTE: this file is the SEED source — tools/bootstrap.sh copies it to
# apps/web/.env on a fresh clone (cp -n). An absolute URL here would bake the
# absolute base into every fresh checkout and break port-forwarded setups.
VITE_API_URL=

# Debug session recorder (dev tool). 1 = `?debug=1`
VITE_DEBUG_SESSION=

# Base URL of the web frontend for CLI deep links (fm-show skill).
# Only needed when the frontend is NOT reachable at http://localhost:5173
# (remote host, different port mapping). Read by the skill from the shell env,
# not by the app itself.
# FMLAB_WEB_URL=http://localhost:5173
