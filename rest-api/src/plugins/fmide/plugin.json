{
  "name": "fmide",
  "version": "1.0.0",
  "description": "fmIDE Thingamajig URI navigation",
  "enabled": true,
  "routes_prefix": "/fmide",
  "config": {
    "fmp_protocol": "fmp",
    "server_address": "$",
    "script_name": "fmIDE"
  },
  "settings_schema": {
    "fmp_protocol": {
      "type": "select",
      "label": "FMP protocol",
      "description": "fmp or fmps (TLS)",
      "options": ["fmp", "fmps"],
      "default": "fmp"
    },
    "server_address": {
      "type": "string",
      "label": "Server address",
      "description": "$ for the current file, otherwise a host/IP",
      "default": "$"
    },
    "script_name": {
      "type": "string",
      "label": "Script name",
      "description": "Name of the target script in the FileMaker file",
      "default": "fmIDE"
    }
  },
  "ui": {
    "frontend_module": "fmide",
    "supported_object_types": [
      "Script",
      "Field",
      "Layout",
      "CustomFunction",
      "ValueList",
      "BaseTable",
      "TableOccurrence",
      "Relationship"
    ]
  }
}
