{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": { "columns": 12, "gap": 16 },
    "children": [
      {
        "type": "Card",
        "id": "hc_kpi_card",
        "props": { "span": 12, "variant": "hero" },
        "data": { "dataset": "hc_kpi" },
        "children": [
          {
            "type": "KPIStrip",
            "id": "hc_kpi_strip",
            "props": {
              "items": [
                {
                  "label": "All checks",
                  "field": "total",
                  "format": "number",
                  "onClick": { "action": "openDashboard", "args": { "id": "health_hints", "params": { "severity": "", "file": "{{file}}" } } }
                },
                {
                  "label": "Errors",
                  "field": "error",
                  "format": "number",
                  "onClick": { "action": "openDashboard", "args": { "id": "health_hints", "params": { "severity": "error", "file": "{{file}}" } } }
                },
                {
                  "label": "Warnings",
                  "field": "warn",
                  "format": "number",
                  "onClick": { "action": "openDashboard", "args": { "id": "health_hints", "params": { "severity": "warn", "file": "{{file}}" } } }
                },
                {
                  "label": "Info",
                  "field": "info",
                  "format": "number",
                  "onClick": { "action": "openDashboard", "args": { "id": "health_hints", "params": { "severity": "info", "file": "{{file}}" } } }
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "hc_security_card",
        "props": { "span": 4, "title": "Security" },
        "data": { "dataset": "hc_security" },
        "children": [
          {
            "type": "List",
            "id": "hc_security_list",
            "props": {
              "rowTemplate": {
                "primary": "{{label}}",
                "secondary": "{{value}}",
                "badge": "{{severity}}",
                "onClick": { "action": "{{action}}", "argsString": "{{action_args}}" }
              },
              "empty": { "message": "Nothing to report." }
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "hc_fields_card",
