    { "id": "hc_scripts",         "source": "bundle:data/hc_scripts.sql" },
    { "id": "hc_relationships",   "source": "bundle:data/hc_relationships.sql" },
    { "id": "hc_tables",          "source": "bundle:data/hc_tables.sql" },
    { "id": "hc_layouts",         "source": "bundle:data/hc_layouts.sql" },
    { "id": "hc_variables",       "source": "bundle:data/hc_variables.sql" },
    { "id": "hc_valuelists",      "source": "bundle:data/hc_valuelists.sql" },
