{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": { "columns": 12, "gap": 16 },
    "children": [
      {
        "type": "Card",
        "props": { "span": 12, "title": "If/Else asymmetry overview", "variant": "hero" },
        "data": { "dataset": "if_else_kpi" },
        "children": [
          {
            "type": "KPIStrip",
            "props": {
              "items": [
                { "label": "Asymmetric blocks", "field": "asymmetric_blocks", "format": "number" },
                { "label": "Affected scripts",  "field": "affected_scripts",  "format": "number" },
                { "label": "Affected files",    "field": "affected_files",    "format": "number" },
                { "label": "Longest If branch", "field": "max_if_len",        "format": "number" }
              ]
            }
          }
        ]
      },

      {
        "type": "Card",
        "props": { "span": 12, "title": "Scripts with long If / short Else" },
        "data": { "dataset": "if_else_blocks" },
        "children": [
          {
            "type": "Table",
            "props": {
              "rowKey": "row_key",
              "density": "comfortable",
              "columns": [
                { "field": "file",            "label": "File" },
                { "field": "name",            "label": "Script name" },
                { "field": "if_pos",          "label": "If position", "align": "right", "format": "number" },
                { "field": "if_len",          "label": "If steps",    "align": "right", "format": "number" },
                { "field": "else_len",        "label": "Else steps",  "align": "right", "format": "number" },
                { "field": "asymmetry_score", "label": "Score",       "align": "right", "format": "number" }
              ],
              "onRowClick": {
                "action": "openObject",
                "args": { "uuid": "{{uuid}}", "type": "Script" }
              },
              "empty": { "message": "No asymmetric If/Else blocks found." }
            }
          }
        ]
      }
    ]
  }
}
