{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": { "columns": 12, "gap": 16 },
    "children": [
      {
        "type": "Card",
        "props": { "span": 12, "title": "TO-DO overview", "variant": "hero" },
        "data": { "dataset": "todo_kpi" },
        "children": [
          { "type": "KPIStrip",
            "props": {
              "items": [
                { "label": "TO-DO lines", "field": "todo_steps",   "format": "number" },
                { "label": "Scripts",     "field": "todo_scripts", "format": "number" },
                { "label": "Files",       "field": "todo_files",   "format": "number" }
              ]
            }
          }
        ]
      },

      {
        "type": "Card",
        "props": { "span": 12, "title": "Scripts with TO-DOs" },
        "data": { "dataset": "todo_scripts" },
        "children": [
          { "type": "Table",
            "props": {
              "rowKey": "uuid",
              "density": "comfortable",
              "columns": [
                { "field": "file",       "label": "File" },
                { "field": "name",       "label": "Script name" },
                { "field": "todo_count", "label": "Count", "align": "right", "format": "number" }
              ],
              "onRowClick": { "action": "openObject",
                              "args": {
                                "uuid": "{{uuid}}",
                                "type": "Script",
                                "params": { "sq": "{{search_term}}" }
                              } }
            }
          }
        ]
      }
    ]
  }
}
