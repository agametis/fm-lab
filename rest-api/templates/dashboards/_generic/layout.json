{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": { "columns": 12, "gap": 16 },
    "children": [
      {
        "type": "Card",
        "props": { "span": 12, "variant": "header" },
        "data": { "dataset": "query_meta" },
        "children": [
          {
            "type": "Markdown",
            "props": {
              "content": "**{{title}}** — {{description | default:—}}"
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": { "span": 12 },
        "data": { "dataset": "results" },
        "children": [
          {
            "type": "AutoTable",
            "props": {
              "metaDataset": "query_meta",
              "density": "comfortable",
              "sortable": true,
              "searchable": true,
              "maxHeight": "70vh"
            }
          }
        ]
      }
    ]
  }
}
