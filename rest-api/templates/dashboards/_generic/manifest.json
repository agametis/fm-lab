{
  "id": "_generic",
  "version": "1.0.0",
  "title": "Custom-Query-Ergebnis",
  "description": "Generischer Renderer für ein beliebiges sql-custom-Template.",
  "author": "fm-lab core",
  "icon": "query",
  "tags": ["internal", "generic"],
  "entry": "layout.json",
  "datasets": [
    { "id": "query_meta", "source": "builtin:query_meta" },
    { "id": "results",    "source": "custom:{{query}}" }
  ],
  "params": [
    { "name": "query", "type": "string", "required": true,
      "description": "Name des sql-custom-Templates (ohne .sql)" },
    { "name": "file",  "type": "string", "required": false,
      "description": "Optionaler Dateifilter — wird an das Template weitergereicht." }
  ],
  "permissions": { "read_only": true, "allow_navigation": true }
}
