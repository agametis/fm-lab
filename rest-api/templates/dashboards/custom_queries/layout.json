{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": { "columns": 12, "gap": 16 },
    "children": [
      {
        "type": "Card",
        "props": { "span": 12, "title": "Analysen & Custom-Queries", "subtitle": "Klick öffnet die Analyse im Generischen Renderer." },
        "data": { "dataset": "queries" },
        "children": [
          {
            "type": "TileGrid",
            "props": {
              "minTileWidth": 260,
              "tile": {
                "title":    "{{title}}",
                "subtitle": "{{description}}",
                "badge":    "{{category}}",
                "onClick": {
                  "action": "runQuery",
                  "args":   { "query": "{{name}}" }
                }
              }
            }
          }
        ]
      }
    ]
  }
}
