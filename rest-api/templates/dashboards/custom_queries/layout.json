{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "queries",
        "props": {
          "span": 12
        },
        "data": {
          "dataset": "queries"
        },
        "children": [
          {
            "type": "TileGrid",
            "props": {
              "viewToggle": true,
              "minTileWidth": 260,
              "tile": {
                "title": "{{title}}",
                "subtitle": "{{description}}",
                "badge": "{{category}}",
                "onClick": {
                  "action": "runQuery",
                  "args": {
                    "query": "{{name}}"
                  }
                }
              }
            }
          }
        ]
      }
    ]
  }
}
