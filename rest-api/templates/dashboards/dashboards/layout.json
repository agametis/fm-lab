{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "dashboards",
        "props": {
          "span": 12
        },
        "data": {
          "dataset": "dashboards"
        },
        "children": [
          {
            "type": "TileGrid",
            "props": {
              "viewToggle": true,
              "minTileWidth": 260,
              "groupBy": "folder",
              "tile": {
                "title": "{{title}}",
                "subtitle": "{{description}}",
                "icon": "{{icon}}",
                "onClick": {
                  "action": "openDashboard",
                  "args": {
                    "id": "{{id}}"
                  }
                }
              }
            }
          }
        ]
      }
    ]
  }
}
