{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": { "columns": 12, "gap": 16 },
    "children": [
      {
        "type": "Card",
        "props": { "span": 12, "title": "Dashboards", "subtitle": "Click a tile to open the selected dashboard." },
        "data": { "dataset": "dashboards" },
        "children": [
          {
            "type": "TileGrid",
            "props": {
              "minTileWidth": 260,
              "tile": {
                "title":    "{{title}}",
                "subtitle": "{{description}}",
                "icon":     "{{icon}}",
                "onClick": {
                  "action": "openDashboard",
                  "args":   { "id": "{{id}}" }
                }
              }
            }
          }
        ]
      }
    ]
  }
}
