{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": { "columns": 12, "gap": 16 },
    "children": [
      {
        "type": "Card",
        "props": {
          "span": 12,
          "title": "Installed",
          "subtitle": "Documentation sources installed in this project. Click an entry to open the start page."
        },
        "data": { "dataset": "installed" },
        "children": [
          {
            "type": "List",
            "props": {
              "rowTemplate": {
                "primary": "{{name}}",
                "secondary": "{{description}}",
                "tertiary": "{{categories}} categories · {{functions}} functions",
                "quaternary": "{{languages_display}}",
                "onClick": {
                  "action": "openDashboard",
                  "args": { "id": "docset_home", "params": { "id": "{{id}}" } }
                }
              },
              "empty": {
                "message": "No documentation installed — run /install-claris-docs, /install-mbs-docs or /install-fmide-docs."
              }
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "span": 12,
          "title": "Available",
          "subtitle": "Known documentation sources that are not yet installed in this project."
        },
        "data": { "dataset": "available" },
        "children": [
          {
            "type": "List",
            "props": {
              "rowTemplate": {
                "primary": "{{name}}",
                "secondary": "{{description}}",
                "tertiary": "{{languages_display}}",
                "inlineControl": "docsInstall",
                "onClick": {
                  "action": "openUrl",
                  "argsString": "url={{source_url}}"
                }
              },
              "empty": {
                "message": "All known documentation sources are installed."
              }
            }
          }
        ]
      },
      {
        "type": "DocsInstallErrorBezel",
        "props": { "span": 12 }
      }
    ]
  }
}
