{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "props": {
          "span": 12,
          "variant": "hero"
        },
        "data": {
          "dataset": "info"
        },
        "children": [
          {
            "type": "Markdown",
            "props": {
              "content": "# {{name}}\n\n{{description}}\n\n{{online_link_md}}"
            }
          },
          {
            "type": "KPIStrip",
            "id": "info_kpistrip",
            "props": {
              "items": [
                {
                  "label": "Functions",
                  "field": "function_count",
                  "format": "number"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "id": "functions",
        "props": {
          "span": 12,
          "title": "Functions"
        },
        "data": {
          "dataset": "functions"
        },
        "children": [
          {
            "type": "List",
            "id": "functions_list",
            "props": {
              "rowTemplate": {
                "primary": "{{name}}",
                "secondary": "{{signature}}",
                "tertiary": "{{canonical}}",
                "badge": "{{code_ref_count}}",
                "badgeOptions": {
                  "hideZero": true,
                  "filterable": true,
                  "onClick": {
                    "action": "{{badge_action}}",
                    "argsString": "{{badge_action_args}}"
                  }
                },
                "onClick": {
                  "action": "{{action}}",
                  "argsString": "{{action_args}}"
                }
              },
              "empty": {
                "message": "No functions available for this category."
              }
            }
          }
        ]
      }
    ]
  }
}
