{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "props": {
          "span": 12,
          "title": "Project overview",
          "variant": "hero"
        },
        "data": {
          "dataset": "project_summary"
        },
        "children": [
          {
            "type": "KPIStrip",
            "props": {
              "items": [
                {
                  "label": "Files",
                  "field": "file_count"
                },
                {
                  "label": "Objects",
                  "field": "total_objects",
                  "format": "number"
                },
                {
                  "label": "FM version",
                  "field": "fm_versions"
                },
                {
                  "label": "DDR info",
                  "field": "ddr_status",
                  "format": "badge"
                },
                {
                  "label": "Last import",
                  "field": "last_import",
                  "format": "date:relative"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "span": 12,
          "title": "Objects"
        },
        "data": {
          "dataset": "object_counts"
        },
        "children": [
          {
            "type": "KPIStrip",
            "props": {
              "items": [
                {
                  "label": "Scripts",
                  "field": "scripts",
                  "onClick": {
                    "action": "applyFilter",
                    "args": {
                      "type": "Script"
                    }
                  }
                },
                {
                  "label": "Fields",
                  "field": "fields",
                  "onClick": {
                    "action": "applyFilter",
                    "args": {
                      "type": "Field"
                    }
                  }
                },
                {
                  "label": "Tables",
                  "field": "tables",
                  "onClick": {
                    "action": "applyFilter",
                    "args": {
                      "type": "BaseTable"
                    }
                  }
                },
                {
                  "label": "TOs",
                  "field": "occurrences",
                  "onClick": {
                    "action": "applyFilter",
                    "args": {
                      "type": "TableOccurrence"
                    }
                  }
                },
                {
                  "label": "Layouts",
                  "field": "layouts",
                  "onClick": {
                    "action": "applyFilter",
                    "args": {
                      "type": "Layout"
                    }
                  }
                },
                {
                  "label": "Custom fns",
                  "field": "custom_functions",
                  "onClick": {
                    "action": "applyFilter",
                    "args": {
                      "type": "CustomFunction"
                    }
                  }
                },
                {
                  "label": "Value lists",
                  "field": "value_lists",
                  "onClick": {
                    "action": "applyFilter",
                    "args": {
                      "type": "ValueList"
                    }
                  }
                },
                {
                  "label": "Relationships",
                  "field": "relationships",
                  "onClick": {
                    "action": "applyFilter",
                    "args": {
                      "type": "Relationship"
                    }
                  }
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "span": 12,
          "title": "Files"
        },
        "data": {
          "dataset": "files_overview"
        },
        "children": [
          {
            "type": "Table",
            "props": {
              "rowKey": "File_Name",
              "density": "comfortable",
              "columns": [
                {
                  "field": "File_Name",
                  "label": "File"
                },
                {
                  "field": "FileMaker_Version",
                  "label": "FM version"
                },
                {
                  "field": "script_count",
                  "label": "Scripts",
                  "align": "right"
                },
                {
                  "field": "table_count",
                  "label": "Tables",
                  "align": "right"
                },
                {
                  "field": "field_count",
                  "label": "Fields",
                  "align": "right"
                },
                {
                  "field": "layout_count",
                  "label": "Layouts",
                  "align": "right"
                },
                {
                  "field": "cf_count",
                  "label": "CFs",
                  "align": "right"
                },
                {
                  "field": "Has_DDR_INFO",
                  "label": "DDR",
                  "format": "badge"
                },
                {
                  "field": "Import_Timestamp",
                  "label": "Imported",
                  "format": "date:relative"
                }
              ],
              "onRowClick": {
                "action": "applyFilter",
                "args": {
                  "file": "{{File_Name}}"
                }
              }
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "span": 4,
          "variant": "navtile"
        },
        "data": {
          "dataset": "nav_dashboards"
        },
        "children": [
          {
            "type": "NavButton",
            "props": {
              "label": "Dashboards",
              "subtitle": "Prepared analyses",
              "icon": "layout-dashboard",
              "showCount": true,
              "onClick": {
                "action": "openDashboard",
                "args": {
                  "id": "dashboards"
                }
              }
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "span": 4,
          "variant": "navtile"
        },
        "data": {
          "dataset": "nav_custom_queries"
        },
        "children": [
          {
            "type": "NavButton",
            "props": {
              "label": "Custom queries",
              "subtitle": "Reusable SQL templates",
              "icon": "database-zap",
              "showCount": true,
              "onClick": {
                "action": "openDashboard",
                "args": {
                  "id": "custom_queries"
                }
              }
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "span": 4,
          "variant": "navtile"
        },
        "data": {
          "dataset": "nav_docs"
        },
        "children": [
          {
            "type": "NavButton",
            "props": {
              "label": "Docs",
              "subtitle": "Installed documentation sources",
              "icon": "book",
              "showCount": true,
              "onClick": {
                "action": "openDashboard",
                "args": {
                  "id": "docs_overview"
                }
              }
            }
          }
        ]
      },
      {
        "type": "Markdown",
        "props": {
          "span": 12,
          "content": "## Tips\n\n- **Search:** type a name into the search box to filter objects — the dashboard hides automatically.\n- **Files:** clicking a row in the files table sets the active file filter for all subsequent views.\n- **Navigation:** *Dashboards* opens curated analyses, *Custom queries* lists every reusable SQL template, *Docs* shows installed documentation sources."
        }
      }
    ]
  }
}
