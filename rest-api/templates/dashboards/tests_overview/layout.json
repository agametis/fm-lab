{
  "schemaVersion": 1,
  "root": {
    "type": "Grid",
    "props": {
      "columns": 12,
      "gap": 16
    },
    "children": [
      {
        "type": "Card",
        "id": "tests",
        "props": {
          "span": 12
        },
        "data": {
          "dataset": "tests"
        },
        "children": [
          {
            "type": "TileGrid",
            "props": {
              "viewToggle": true,
              "minTileWidth": 260,
              "folderNav": true,
              "folderParam": "folder",
              "foldersDataset": "folders",
              "searchable": "auto",
              "searchAutoThreshold": 3,
              "tile": {
                "title": "{{title}}",
                "badge": "{{test_type}}",
                "onClick": {
                  "action": "navigate",
                  "args": { "path": "/tests/{{id}}" }
                }
              }
            }
          }
        ]
      }
    ]
  }
}
